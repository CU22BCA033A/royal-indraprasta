# Copy to .dev.vars for `npm run pages:dev`. In production set these as
# encrypted variables in Cloudflare Pages (Settings > Variables and Secrets).
# Never commit real values.

# Resend API key with permission to send from FROM_EMAIL's domain.
RESEND_API_KEY=

# Inbox that receives enquiries, messages and data requests.
OWNER_EMAIL=

# Sender address on a domain verified in Resend, for example
# "Royal Indraprastha <enquiries@royalindraprastha.in>".
FROM_EMAIL=

# The live site origin, for example https://royalindraprastha.in.
# Form submissions from any other origin are refused.
SITE_ORIGIN=

# Build-time only: canonical URL used in links, sitemap and Open Graph tags.
SITE_URL=
