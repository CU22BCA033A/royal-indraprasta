{
  "name": "royal-indraprastha-site",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/figtree": "^5.3.0",
    "astro": "^7.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/yellowtail": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "html-validate": "^11.17.0",
    "linkinator": "^8.1.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "fonts": "node scripts/fonts.mjs",
    "photos": "node scripts/photos.mjs",
    "brand": "node scripts/brand-assets.mjs",
    "build": "node scripts/photos.mjs && astro build && pagefind --site dist && node scripts/postbuild.mjs",
    "build:demo": "DEMO=1 npm run build",
    "preview": "astro preview --port 4321",
    "check": "astro check && eslint . && prettier --check . && html-validate \"dist/**/*.html\" && node scripts/bundle-api.mjs --check",
    "format": "prettier --write .",
    "test": "node --test tests/unit/*.test.ts && playwright test",
    "test:unit": "node --test tests/unit/*.test.ts",
    "links": "node scripts/links.mjs",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs && node scripts/lighthouse-summary.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:placeholders": "node scripts/audit-placeholders.mjs",
    "qa": "node scripts/qa.mjs",
    "pages:dev": "wrangler pages dev dist",
    "deploy": "wrangler pages deploy dist",
    "api": "node scripts/bundle-api.mjs"
  }
}
