---
import BaseLayout from '../layouts/BaseLayout.astro';
import VegMark from '../components/VegMark.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { t, fmt } from '../content/copy.ts';
import { menu, formatPrice } from '../config/menu.ts';
import { contentDates, formatDate } from '../config/content-dates.ts';
import { liveBranches } from '../data/branches.ts';
import type { PhotoSlug } from '../config/photos.ts';

const anyPrice = menu.some((c) => c.items.some((i) => i.price !== null));
const allSlugs = liveBranches.map((b) => b.slug);
const nameOf = (slug: string) => liveBranches.find((b) => b.slug === slug)?.name ?? slug;
const catPhoto: Record<string, PhotoSlug> = {
  tiffin: 'idli-vada',
  dosa: 'dosa-plate',
  'north-indian': 'north-indian',
  chaat: 'chaat-counter',
  'beverages-desserts': 'coffee',
};
---

<BaseLayout path="/menu/" title={t.meta.menuTitle} description={t.meta.menuDesc}>
  <header class="page-menu">
    <div class="wrap grid">
      <div class="title">
        <h1>{t.menu.title}</h1>
      </div>
      <div class="lead-col">
        <p class="veg-chip"><VegMark label={t.common.pureVeg} /></p>
        <p class="lead">{t.menu.lead}</p>
        <p class="meta-line">
          {t.common.lastUpdated}: <time datetime={contentDates.menu}>{formatDate(contentDates.menu)}</time>
        </p>
      </div>
    </div>
  </header>

  <div class="wrap">
    <div class="menu-tools no-print">
      {
        liveBranches.length > 1 && (
          <fieldset class="seg" data-menu-filter>
            <legend>{t.menu.show}</legend>
            <label>
              <input type="radio" name="menu-branch" value="all" checked />
              {t.menu.all}
            </label>
            {liveBranches.map((b) => (
              <label>
                <input type="radio" name="menu-branch" value={b.slug} />
                {b.name}
              </label>
            ))}
          </fieldset>
        )
      }
      <button type="button" class="btn btn--ghost" data-print><Icon name="print" />{t.menu.print}</button>
    </div>

    {
      menu.map((c, i) => (
        <section class="menu-section" id={c.id} aria-labelledby={`${c.id}-title`}>
          <div class="grid">
            <div class="head">
              <span class="numeral" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h2 id={`${c.id}-title`}>{c.name}</h2>
              {c.note && <p>{c.note}</p>}
            </div>
            <div class="items">
              <table class="menu-table">
                <colgroup>
                  <col class="c-dish" />
                  <col class="c-mark" />
                  {liveBranches.length > 1 && <col class="c-where" />}
                  {anyPrice && <col class="c-price" />}
                </colgroup>
                <thead>
                  <tr>
                    <th scope="col">{t.menu.dish}</th>
                    <th scope="col" class="mark">
                      <span class="visually-hidden">Vegetarian</span>
                    </th>
                    {liveBranches.length > 1 && <th scope="col">{t.menu.branchCol}</th>}
                    {anyPrice && (
                      <th scope="col" class="price">
                        {t.menu.priceCol}
                      </th>
                    )}
                  </tr>
                </thead>
                <tbody>
                  {c.items.map((item) => (
                    <tr data-served={(item.branches ?? allSlugs).join(' ')}>
                      <th scope="row">{item.name}</th>
                      <td class="mark">
                        <VegMark />
                      </td>
                      {liveBranches.length > 1 && (
                        <td class="where">
                          {item.branches
                            ? fmt(t.menu.onlyAt, { name: item.branches.map(nameOf).join(', ') })
                            : t.menu.all}
                        </td>
                      )}
                      {anyPrice && <td class="price">{item.price !== null ? formatPrice(item.price) : ''}</td>}
                    </tr>
                  ))}
                </tbody>
              </table>
              {catPhoto[c.id] && <Photo slug={catPhoto[c.id] as PhotoSlug} sizes="(min-width: 60rem) 60vw, 100vw" />}
            </div>
          </div>
        </section>
      ))
    }
    <p class="meta-line menu-foot">{anyPrice ? t.menu.priceNote : t.menu.pricesSoon}</p>
  </div>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
