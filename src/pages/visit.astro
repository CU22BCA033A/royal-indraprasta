---
import BaseLayout from '../layouts/BaseLayout.astro';
import HoursBoard from '../components/HoursBoard.astro';
import AddressBlock from '../components/AddressBlock.astro';
import Photo from '../components/Photo.astro';
import { t } from '../content/copy.ts';
import { site } from '../config/site.ts';

---

<BaseLayout path="/visit/" title={t.meta.visitTitle} description={t.meta.visitDesc}>
  <div class="page-head">
    <div class="wrap">
      <h1>{t.visit.title}</h1>
      <p>{t.visit.lead}</p>
    </div>
  </div>
  <section class="section" aria-labelledby="address-title">
    <div class="wrap split">
      <div>
        <h2 id="address-title">{t.visit.addressTitle}</h2>
      </div>
      <div class="stack-lg">
        <AddressBlock showPhone />
        <Photo slug="exterior" sizes="(min-width: 52rem) 60vw, 100vw" />
      </div>
    </div>
  </section>
  <section class="section section--surface" aria-labelledby="hours-title">
    <div class="wrap split">
      <div>
        <h2 id="hours-title">{t.hours.title}</h2>
      </div>
      <div class="hours-wrap">
        <HoursBoard headingLevel="h3" />
      </div>
    </div>
  </section>
  {
    (site.access || site.parking) && (
      <section class="section" aria-labelledby="access-title">
        <div class="wrap split">
          <div>
            <h2 id="access-title">{t.visit.accessTitle}</h2>
          </div>
          <div class="stack">
            {site.access?.map((p) => (
              <p>{p}</p>
            ))}
            <Photo slug="entrance" sizes="(min-width: 52rem) 40vw, 100vw" />
            {site.parking && <h3>{t.visit.parkingTitle}</h3>}
            {site.parking?.map((p) => (
              <p>{p}</p>
            ))}
            <Photo slug="parking" sizes="(min-width: 52rem) 60vw, 100vw" />
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
