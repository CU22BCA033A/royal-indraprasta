---
import BaseLayout from '../layouts/BaseLayout.astro';
import AddressBlock from '../components/AddressBlock.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { t } from '../content/copy.ts';
import { site } from '../config/site.ts';

---

<BaseLayout path="/contact/" title={t.meta.contactTitle} description={t.meta.contactDesc}>
  <div class="page-head">
    <div class="wrap">
      <h1>{t.contact.title}</h1>
      <p>{t.contact.lead}</p>
    </div>
  </div>
  <section class="section" aria-labelledby="direct-title">
    <div class="wrap split">
      <div>
        <h2 id="direct-title">{t.visit.phoneTitle}</h2>
      </div>
      <div class="stack-lg">
        <AddressBlock showPhone />
        {
          site.email && (
            <p>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          )
        }
      </div>
    </div>
  </section>
  <section class="section section--surface" aria-label={t.contact.formTitle}>
    <div class="wrap split">
      <div></div>
      <ContactForm title={t.contact.formTitle} />
    </div>
  </section>
</BaseLayout>
