---
import LegalPage from '../../components/LegalPage.astro';
import { dict, langPaths, type Lang } from '../../i18n/index.ts';
import { privacy } from '../../content/legal.ts';

export function getStaticPaths() {
  return langPaths();
}
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict(lang);
// Kannada heading: NEEDS-NATIVE-REVIEW
const heading = lang === 'kn' ? 'ಗೌಪ್ಯತಾ ನೀತಿ' : 'Privacy Policy';
---

<LegalPage
  lang={lang}
  path="/privacy/"
  title={t.meta.privacyTitle}
  description={t.meta.privacyDesc}
  heading={heading}
  dateKey="privacy"
  doc={privacy()}
/>
