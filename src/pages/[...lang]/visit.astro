---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HoursBoard from '../../components/HoursBoard.astro';
import AddressBlock from '../../components/AddressBlock.astro';
import Photo from '../../components/Photo.astro';
import { dict, langPaths, type Lang } from '../../i18n/index.ts';
import { site } from '../../config/site.ts';

export function getStaticPaths() {
  return langPaths();
}
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict(lang);
---

<BaseLayout lang={lang} path="/visit/" title={t.meta.visitTitle} description={t.meta.visitDesc}>
  <div class="page-head">
    <div class="wrap">
      <h1>{t.visit.title}</h1>
      <p>{t.visit.lead}</p>
    </div>
  </div>
  <section class="section" aria-labelledby="address-title">
    <div class="wrap split">
      <div>
        <h2 id="address-title">{t.visit.addressTitle}</h2>
      </div>
      <div class="stack-lg">
        <AddressBlock lang={lang} showPhone />
        <Photo slug="exterior" lang={lang} sizes="(min-width: 52rem) 60vw, 100vw" />
      </div>
    </div>
  </section>
  <section class="section section--surface" aria-labelledby="hours-title">
    <div class="wrap split">
      <div>
        <h2 id="hours-title">{t.hours.title}</h2>
      </div>
      <div class="hours-wrap">
        <HoursBoard lang={lang} headingLevel="h3" />
      </div>
    </div>
  </section>
  {
    (site.access || site.parking) && (
      <section class="section" aria-labelledby="access-title">
        <div class="wrap split">
          <div>
            <h2 id="access-title">{t.visit.accessTitle}</h2>
          </div>
          <div class="stack">
            {site.access?.[lang].map((p) => (
              <p>{p}</p>
            ))}
            <Photo slug="entrance" lang={lang} sizes="(min-width: 52rem) 40vw, 100vw" />
            {site.parking && <h3>{t.visit.parkingTitle}</h3>}
            {site.parking?.[lang].map((p) => (
              <p>{p}</p>
            ))}
            <Photo slug="parking" lang={lang} sizes="(min-width: 52rem) 60vw, 100vw" />
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
