---
import LegalPage from '../../components/LegalPage.astro';
import { dict, langPaths, type Lang } from '../../i18n/index.ts';
import { terms } from '../../content/legal.ts';

export function getStaticPaths() {
  return langPaths();
}
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict(lang);
// Kannada heading: NEEDS-NATIVE-REVIEW
const heading = lang === 'kn' ? 'ನಿಯಮಗಳು ಮತ್ತು ಷರತ್ತುಗಳು' : 'Terms and Conditions';
---

<LegalPage
  lang={lang}
  path="/terms/"
  title={t.meta.termsTitle}
  description={t.meta.termsDesc}
  heading={heading}
  dateKey="terms"
  doc={terms()}
/>
