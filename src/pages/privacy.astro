---
import LegalPage from '../components/LegalPage.astro';
import { t } from '../content/copy.ts';
import { privacy } from '../content/legal.ts';

const heading = 'Privacy Policy';
---

<LegalPage
  path="/privacy/"
  title={t.meta.privacyTitle}
  description={t.meta.privacyDesc}
  heading={heading}
  dateKey="privacy"
  doc={privacy()}
/>
