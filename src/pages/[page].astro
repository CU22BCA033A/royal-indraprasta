---
/**
 * Optional pages, built only when their content is confirmed:
 * - /stay/  when site.modules.stay is true and site.stayDetails is set
 *           (the hotel at SN Plaza is a separate listing; see docs/RESEARCH.md)
 * - /about/ when the owner has supplied site.story
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../content/copy.ts';
import { site } from '../config/site.ts';

export function getStaticPaths() {
  const pages: { params: { page: string } }[] = [];
  if (site.modules.stay && site.stayDetails) pages.push({ params: { page: 'stay' } });
  if (site.story) pages.push({ params: { page: 'about' } });
  return pages;
}
const { page } = Astro.params;
const s = site.stayDetails;
const hotelLd =
  page === 'stay' && s
    ? {
        '@context': 'https://schema.org',
        '@type': 'Hotel',
        name: 'Royal Indraprastha The Hotel',
        address: s.address,
        ...(s.phone ? { telephone: s.phone } : {}),
      }
    : null;
---

{
  page === 'stay' ? (
    <BaseLayout path="/stay/" title={t.meta.stayTitle} description={t.meta.stayDesc} jsonld={hotelLd ? [hotelLd] : []}>
      <div class="page-head">
        <div class="wrap">
          <h1>{t.stay.title}</h1>
          <p>{t.stay.lead}</p>
        </div>
      </div>
      {s && (
        <section class="section">
          <div class="wrap stack">
            <address class="address">{s.address}</address>
            {s.phone && s.phoneDisplay && (
              <p>
                <a class="btn" href={`tel:${s.phone}`}>
                  {s.phoneDisplay}
                </a>
              </p>
            )}
          </div>
        </section>
      )}
    </BaseLayout>
  ) : (
    <BaseLayout path="/about/" title={t.meta.aboutTitle} description={t.meta.aboutDesc}>
      <div class="page-head">
        <div class="wrap">
          <h1>{t.about.title}</h1>
        </div>
      </div>
      <section class="section">
        <div class="wrap prose">{site.story?.map((p) => <p>{p}</p>)}</div>
      </section>
    </BaseLayout>
  )
}
