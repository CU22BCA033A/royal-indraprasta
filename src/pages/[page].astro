---
/** The About page, built only when the owner has supplied site.story. */
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../content/copy.ts';
import { site } from '../config/site.ts';

export function getStaticPaths() {
  return site.story ? [{ params: { page: 'about' } }] : [];
}
---

<BaseLayout path="/about/" title={t.meta.aboutTitle} description={t.meta.aboutDesc}>
  <header class="band--sign page-sign">
    <div class="wrap">
      <h1>{t.about.title}</h1>
    </div>
  </header>
  <section class="band">
    <div class="wrap prose">{site.story?.map((p) => <p>{p}</p>)}</div>
  </section>
</BaseLayout>
