---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import { hasPhoto } from '../lib/photos.ts';
import FaqList from '../components/FaqList.astro';
import EnquiryForm from '../components/forms/EnquiryForm.astro';
import Icon from '../components/Icon.astro';
import { t } from '../content/copy.ts';
import { faqsFor } from '../config/faq.ts';
import { liveBranches, branchAddress } from '../data/branches.ts';
import { venueJsonLd } from '../lib/seo.ts';

const origin = (Astro.site?.href ?? '').replace(/\/$/, '');
const hallBranch = liveBranches.find((b) => b.services.banquet);
const h = hallBranch?.hall ?? null;
const venue = hallBranch ? venueJsonLd(origin, hallBranch) : null;
const hasFacts = h && (h.name || h.seated !== null || h.standing !== null || h.inclusions);
---

<BaseLayout path="/banquet/" title={t.meta.banquetTitle} description={t.meta.banquetDesc} jsonld={venue ? [venue] : []}>
  <header class="band--sign page-sign">
    <div class="wrap grid">
      <div class="title">
        <h1>{t.banquet.title}</h1>
      </div>
      <div class="lead-col">
        <p class="lead">{t.banquet.lead}</p>
        {
          hallBranch && (
            <p class="meta-line">
              {h?.name && <strong>{h.name}. </strong>}
              {branchAddress(hallBranch)}
            </p>
          )
        }
      </div>
    </div>
  </header>

  {
    !hasPhoto('banquet-wide') && (
      <div class="wrap branch-hero">
        <Photo
          slug="cariappa-render"
          sizes="(min-width: 82rem) 78rem, 100vw"
          eager
          caption={t.banquet.renderCaption}
        />
      </div>
    )
  }

  <section class="band hall" aria-labelledby="steps-title">
    <div class="wrap grid">
      <div class="statement">
        <h2 id="steps-title">{t.banquet.stepsTitle}</h2>
        {
          hasFacts && h && (
            <dl class="facts">
              {h.name && (
                <div>
                  <dt>{t.banquet.hall}</dt>
                  <dd>{h.name}</dd>
                </div>
              )}
              {h.seated !== null && (
                <div>
                  <dt>Seated</dt>
                  <dd class="num">{h.seated}</dd>
                </div>
              )}
              {h.standing !== null && (
                <div>
                  <dt>Standing</dt>
                  <dd class="num">{h.standing}</dd>
                </div>
              )}
            </dl>
          )
        }
        {
          h?.inclusions && (
            <p>
              {t.banquet.included}: {h.inclusions.join(', ')}
            </p>
          )
        }
        <Photo slug="banquet-wide" sizes="(min-width: 60rem) 45vw, 100vw" />
      </div>
      <div class="steps-col">
        <ol class="steps" role="list">
          {
            t.banquet.steps.map(([title, body], i) => (
              <li>
                <span class="numeral" aria-hidden="true">
                  {i + 1}
                </span>
                <div>
                  <strong>{title}</strong>
                  <p>{body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="band band--paper enquiry" id="enquiry" aria-label={t.banquet.formTitle}>
    <div class="wrap grid">
      <div class="enquiry-side">
        <p class="kicker">{t.banquet.formSide}</p>
        {
          hallBranch?.phone && (
            <p class="enquiry-phone">
              <a href={`tel:${hallBranch.phone.e164}`} class="tel-label">
                <Icon name="phone" />
                {hallBranch.phone.display}
              </a>
            </p>
          )
        }
        <Photo slug="banquet-stage" sizes="(min-width: 60rem) 30vw, 100vw" />
      </div>
      <div class="enquiry-form">
        <EnquiryForm title={t.banquet.formTitle} />
      </div>
    </div>
  </section>

  <section class="band qa" aria-labelledby="bfaq-title">
    <div class="wrap grid">
      <div class="side">
        <h2 id="bfaq-title">{t.banquet.faqTitle}</h2>
      </div>
      <div class="list">
        <FaqList items={faqsFor('banquet')} />
      </div>
    </div>
  </section>
</BaseLayout>
