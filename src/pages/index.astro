---
import BaseLayout from '../layouts/BaseLayout.astro';
import TodayLedger from '../components/TodayLedger.astro';
import BranchLedger from '../components/BranchLedger.astro';
import FaqList from '../components/FaqList.astro';
import Photo from '../components/Photo.astro';
import VegMark from '../components/VegMark.astro';
import Tumbler from '../components/Tumbler.astro';
import Icon from '../components/Icon.astro';
import { t, fmt, branchCount } from '../content/copy.ts';
import { menu, itemsFor } from '../config/menu.ts';
import { faqsFor } from '../config/faq.ts';
import { liveBranches, mainBranch, branchMapsUrl } from '../data/branches.ts';
import { restaurantJsonLd } from '../lib/seo.ts';
import { hasPhoto } from '../lib/photos.ts';

const counts = branchCount(liveBranches.length);
const origin = (Astro.site?.href ?? '').replace(/\/$/, '');
const hallBranch = liveBranches.find((b) => b.services.banquet);
const boardCats = menu.filter((c) => ['tiffin', 'dosa', 'north-indian', 'chaat'].includes(c.id));
---

<BaseLayout
  path="/"
  title={t.meta.homeTitle}
  description={t.meta.homeDesc}
  jsonld={liveBranches.map((b) => restaurantJsonLd(origin, b))}
  signHeader
>
  <section class="band--sign sign-hero" aria-labelledby="hero-title">
    <div class="wrap grid">
      <div class="board">
        <p class="kicker kicker--split"><span>{t.common.pureVeg}</span><span>{t.home.kickerPlace}</span></p>
        <h1 id="hero-title" class="sign-title">
          <span class="name"><span>Royal</span><span>Indraprastha</span></span>
          <span class="line">{fmt(t.home.line, counts)}</span>
        </h1>
        <p class="sign-dishes">{t.home.dishes}</p>
        <div class="btn-row" data-hero-cta>
          {
            mainBranch.phone && (
              <a class="btn" href={`tel:${mainBranch.phone.e164}`}>
                <Icon name="phone" />
                {fmt(t.common.callBranch, { name: mainBranch.name })}
              </a>
            )
          }
          <a class="btn btn--ghost" href="/menu/">{t.home.menuLink}</a>
        </div>
      </div>
      <TodayLedger />
    </div>
  </section>

  {hasPhoto('exterior') && (
    <div class="wrap band--tight">
      <Photo slug="exterior" sizes="(min-width: 82rem) 78rem, 100vw" />
    </div>
  )}

  <section class="band menu-board" aria-labelledby="menu-title">
    <div class="wrap grid">
      <div class="intro">
        <p class="kicker">{t.home.menuKicker}</p>
        <h2 id="menu-title">{t.home.menuTitle}</h2>
        <p>{t.home.menuLead}</p>
        <a class="arrow-link" href="/menu/">{t.home.menuLink}</a>
        <Tumbler class="tumbler" />
      </div>
      <div class="columns">
        {
          boardCats.map((c, i) => (
            <section aria-labelledby={`board-${c.id}`}>
              <h3 id={`board-${c.id}`}>
                <span class="numeral" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {c.name}
              </h3>
              <ul class="dish-list" role="list">
                {itemsFor(c, null).map((item) => (
                  <li>
                    <span>{item.name}</span>
                    {item.branches ? (
                      <span class="where-note">
                        {item.branches
                          .map((s) => liveBranches.find((b) => b.slug === s)?.name)
                          .filter(Boolean)
                          .join(', ')}
                      </span>
                    ) : (
                      <VegMark />
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  {
    hallBranch && (
      <section class="band band--paper hall" aria-labelledby="hall-title">
        <div class="wrap grid">
          <div class="statement">
            <p class="kicker">{t.home.hallKicker}</p>
            <h2 id="hall-title">{t.home.hallTitle}</h2>
            <p>{t.home.hallLead}</p>
            {hallBranch.hall && (hallBranch.hall.seated !== null || hallBranch.hall.standing !== null) && (
              <dl class="facts">
                {hallBranch.hall.seated !== null && (
                  <div>
                    <dt>Seated</dt>
                    <dd class="num">{hallBranch.hall.seated}</dd>
                  </div>
                )}
                {hallBranch.hall.standing !== null && (
                  <div>
                    <dt>Standing</dt>
                    <dd class="num">{hallBranch.hall.standing}</dd>
                  </div>
                )}
              </dl>
            )}
            <div class="btn-row">
              <a class="btn" href="/banquet/#enquiry">
                {t.home.hallLink}
              </a>
            </div>
          </div>
          <div class="steps-col">
            <Photo slug="banquet-wide" sizes="(min-width: 60rem) 40vw, 100vw" />
            <ol class="steps" role="list">
              {t.banquet.steps.map(([title, body], i) => (
                <li>
                  <span class="numeral" aria-hidden="true">
                    {i + 1}
                  </span>
                  <div>
                    <strong>{title}</strong>
                    <p>{body}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    )
  }

  <section class="band" aria-labelledby="branches-title">
    <div class="wrap">
      <div class="grid ledger-head">
        <h2 id="branches-title">{fmt(t.home.branchesTitle, counts)}</h2>
        <p class="side">{t.home.branchesSide}</p>
      </div>
      <BranchLedger />
      <p class="meta-line reviews-line">
        <a href={branchMapsUrl(mainBranch)} rel="noopener" target="_blank"
          >{t.home.reviewsLine}<span class="visually-hidden"> ({t.common.newTab})</span></a
        >
      </p>
    </div>
  </section>

  <section class="band band--paper qa" aria-labelledby="faq-title">
    <div class="wrap grid">
      <div class="side">
        <h2 id="faq-title">{t.home.faqTitle}</h2>
        <a class="arrow-link" href="/faq/">{t.home.faqLink}</a>
      </div>
      <div class="list">
        <FaqList items={faqsFor('home')} />
      </div>
    </div>
  </section>
</BaseLayout>
