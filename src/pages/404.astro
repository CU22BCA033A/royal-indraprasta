---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../content/copy.ts';
import { site } from '../config/site.ts';
---

<BaseLayout
  path="/404/"
  title={t.meta.notFoundTitle}
  description={t.meta.notFoundDesc}
  single
  noindex
  searchable={false}
>
  <section class="section">
    <div class="wrap split">
      <div class="lattice-panel" aria-hidden="true"></div>
      <div class="stack-lg">
        <div class="stack">
          <h1>{t.notFound.title}</h1>
          <p>{t.notFound.lead}</p>
          <div class="btn-row">
            <a class="btn" href="/">{t.notFound.home}</a>
            <a class="btn btn--ghost" href="/menu/">{t.notFound.menu}</a>
            <a class="btn btn--ghost" href="/visit/">{t.notFound.visit}</a>
          </div>
        </div>
        <p><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
