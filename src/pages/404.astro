---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../content/copy.ts';
import { site } from '../config/site.ts';
---

<BaseLayout
  path="/404/"
  title={t.meta.notFoundTitle}
  description={t.meta.notFoundDesc}
  single
  noindex
  searchable={false}
>
  <section class="band--sign page-sign not-found">
    <div class="wrap grid">
      <div class="title">
        <h1>{t.notFound.title}</h1>
      </div>
      <div class="lead-col">
        <p class="lead">{t.notFound.lead}</p>
        <div class="btn-row">
          <a class="btn" href="/">{t.notFound.home}</a>
          <a class="btn btn--ghost" href="/menu/">{t.notFound.menu}</a>
          <a class="btn btn--ghost" href="/locations/">{t.notFound.visit}</a>
        </div>
        <p class="meta-line call-line">
          Or call <a class="tel-label" href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
        </p>
      </div>
    </div>
    <div class="wrap">
      <div class="lattice" aria-hidden="true"></div>
    </div>
  </section>
</BaseLayout>
