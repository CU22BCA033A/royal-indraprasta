---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqList from '../components/FaqList.astro';
import { t } from '../content/copy.ts';
import { faqsFor } from '../config/faq.ts';
import { contentDates, formatDate } from '../config/content-dates.ts';

const items = faqsFor();
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout path="/faq/" title={t.meta.faqTitle} description={t.meta.faqDesc} jsonld={[faqLd]}>
  <header class="page-quiet">
    <div class="wrap grid">
      <div class="title">
        <h1>{t.faq.title}</h1>
      </div>
      <div class="lead-col">
        <p class="lead">{t.faq.lead}</p>
        <p class="meta-line">
          {t.common.lastUpdated}: <time datetime={contentDates.faq}>{formatDate(contentDates.faq)}</time>
        </p>
      </div>
    </div>
  </header>
  <section class="band qa" aria-label={t.faq.title}>
    <div class="wrap grid">
      <div class="list list--wide">
        <FaqList items={items} />
      </div>
    </div>
  </section>
</BaseLayout>
