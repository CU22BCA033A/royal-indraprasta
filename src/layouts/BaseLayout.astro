---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/print.css';

import { dict, localPath, type Lang } from '../i18n/index.ts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Floating from '../components/Floating.astro';
import { restaurantJsonLd, jsonForScript } from '../lib/seo.ts';

interface Props {
  lang: Lang;
  /** English path of this page, for example "/menu/". */
  path: string;
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page. */
  jsonld?: Record<string, unknown>[];
  /** Pages that exist in one language only (404). */
  single?: boolean;
  noindex?: boolean;
  /** Include the page in site search. */
  searchable?: boolean;
}
const { lang, path, title, description, jsonld = [], single = false, noindex = false, searchable = true } = Astro.props;
const t = dict(lang);
const origin = (Astro.site?.href ?? 'https://royal-indraprastha.pages.dev/').replace(/\/$/, '');
const canonical = `${origin}${localPath(path, lang)}`;
const enUrl = `${origin}${localPath(path, 'en')}`;
const knUrl = `${origin}${localPath(path, 'kn')}`;
const otherHref = localPath(path, lang === 'en' ? 'kn' : 'en');
const ld = [restaurantJsonLd(origin), ...jsonld];
const preloads =
  lang === 'kn'
    ? ['/fonts/noto-sans-kannada-400.woff2', '/fonts/noto-serif-kannada-600.woff2']
    : ['/fonts/figtree-400.woff2', '/fonts/young-serif-400.woff2'];
const isEnHome = lang === 'en' && path === '/';
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!single && <link rel="canonical" href={canonical} />}
    {
      !single && (
        <>
          <link rel="alternate" hreflang="en-IN" href={enUrl} />
          <link rel="alternate" hreflang="kn-IN" href={knUrl} />
          <link rel="alternate" hreflang="x-default" href={enUrl} />
        </>
      )
    }
    <meta name="theme-color" content="#f6efe2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1512" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Royal Indraprastha" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'kn' ? 'kn_IN' : 'en_IN'} />
    <meta property="og:locale:alternate" content={lang === 'kn' ? 'en_IN' : 'kn_IN'} />
    <meta property="og:image" content={`${origin}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Royal Indraprastha wordmark on ivory with a maroon lattice mark" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${origin}/og.png`} />

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('ri-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    {
      isEnHome && (
        <script is:inline>
          (function () {
            try {
              var sameSite = document.referrer.indexOf(location.origin) === 0;
              if (!sameSite && localStorage.getItem('ri-lang') === 'kn' && location.search.indexOf('lang=en') === -1) {
                location.replace('/kn/');
              }
            } catch (e) {}
          })();
        </script>
      )
    }
    {ld.map((d) => <script type="application/ld+json" set:html={jsonForScript(d)} />)}
  </head>
  <body id="top">
    <a class="skip" href="#main">{t.common.skip}</a>
    <div class="progress" aria-hidden="true"></div>
    <Header lang={lang} path={path} otherHref={otherHref} />
    <main id="main" tabindex="-1" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <Footer lang={lang} otherHref={otherHref} />
    <Floating lang={lang} />
    <script>
      import '../client/main.ts';
    </script>
  </body>
</html>
