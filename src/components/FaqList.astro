---
import type { Faq } from '../config/faq.ts';
interface Props {
  items: Faq[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((f) => (
      <details id={`q-${f.id}`}>
        <summary>{f.q}</summary>
        <div class="answer">
          <p>{f.a}</p>
        </div>
      </details>
    ))
  }
</div>
