---
/** Mobile contact button, back-to-top button and the storage notice. */
import { t, fmt } from '../content/copy.ts';
import { site, whatsappUrl } from '../config/site.ts';
import { liveBranches, branchDirectionsUrl } from '../data/branches.ts';
import Icon from './Icon.astro';

const wa = whatsappUrl();
const consent = site.modules.analytics;
---

<aside class="float float--contact" aria-label={t.common.contactPanel} data-contact>
  <div class="contact-panel" id="contact-panel" hidden>
    {
      liveBranches.map((b) => (
        <div>
          <p>{b.name}</p>
          <ul role="list">
            {b.phone && (
              <li>
                <a class="tel-label" href={`tel:${b.phone.e164}`}>
                  <Icon name="phone" />
                  {t.common.call} {b.phone.display}
                </a>
              </li>
            )}
            <li>
              <a href={branchDirectionsUrl(b)} rel="noopener" target="_blank">
                <Icon name="pin" />
                {fmt(t.common.directionsTo, { name: b.name })}
                <span class="visually-hidden"> ({t.common.newTab})</span>
              </a>
            </li>
          </ul>
        </div>
      ))
    }
    {
      wa && (
        <ul role="list">
          <li>
            <a href={wa} rel="noopener" target="_blank">
              <Icon name="chat" />
              {t.common.whatsapp}
              <span class="visually-hidden"> ({t.common.newTab})</span>
            </a>
          </li>
        </ul>
      )
    }
  </div>
  <button type="button" class="btn" aria-expanded="false" aria-controls="contact-panel">
    <Icon name="phone" />{t.common.contactOpen}
  </button>
</aside>

<nav class="float float--top" aria-label={t.common.backToTop} data-back-to-top hidden>
  <a class="btn" href="#top"><Icon name="up" />{t.common.backToTop}</a>
</nav>

<aside class="notice" aria-label={t.notice.policy} data-notice data-consent={consent ? 'true' : 'false'} hidden>
  <div class="wrap">
    <p>
      {consent ? t.notice.textConsent : t.notice.text}{' '}
      <a href="/cookies/">{t.notice.policy}</a>
    </p>
    {
      consent ? (
        <div class="btn-row">
          <button type="button" class="btn btn--ghost" data-notice-choice="essential">
            {t.notice.essential}
          </button>
          <button type="button" class="btn btn--ghost" data-notice-choice="all">
            {t.notice.accept}
          </button>
        </div>
      ) : (
        <button type="button" class="btn btn--ghost" data-notice-choice="ok">
          {t.notice.ok}
        </button>
      )
    }
  </div>
</aside>
