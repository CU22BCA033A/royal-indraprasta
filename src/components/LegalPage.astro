---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../content/copy.ts';
import { contentDates, formatDate, type ContentDateKey } from '../config/content-dates.ts';
import type { LegalDoc } from '../content/legal.ts';

interface Props {
  path: string;
  title: string;
  heading: string;
  description: string;
  dateKey: ContentDateKey;
  doc: LegalDoc;
}
const { path, title, heading, description, dateKey, doc } = Astro.props;
const slug = path.replace(/\//g, '');
---

<BaseLayout path={path} title={title} description={description}>
  <header class="page-quiet">
    <div class="wrap grid">
      <div class="title">
        <p class="kicker">{t.footer.legal}</p>
        <h1>{heading}</h1>
      </div>
      <div class="lead-col">
        <p class="meta-line">
          {t.common.lastUpdated}: <time datetime={contentDates[dateKey]}>{formatDate(contentDates[dateKey])}</time>
        </p>
      </div>
    </div>
  </header>
  <div class="wrap band legal-body">
    <div class="prose">
        {
          doc.sections.map((s, i) => (
            <>
              <h2 id={`${slug}-${i + 1}`}>{s.h}</h2>
              {s.body.map((b) =>
                typeof b === 'string' ? (
                  <p>{b}</p>
                ) : 'list' in b ? (
                  <ul>
                    {b.list.map((li) => (
                      <li>{li}</li>
                    ))}
                  </ul>
                ) : (
                  <div class="table-scroll">
                    <table>
                      <thead>
                        <tr>
                          {b.table.head.map((h) => (
                            <th scope="col">{h}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {b.table.rows.map((r) => (
                          <tr>
                            {r.map((c, ci) => (
                              <td data-label={b.table.head[ci]}>{c}</td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                ),
              )}
            </>
          ))
        }
      <slot />
    </div>
  </div>
</BaseLayout>
