---
/** Ruled list of branches: photo of the front where supplied, name, address and services, actions. */
import { t, fmt } from '../content/copy.ts';
import { liveBranches, branchAddress, branchDirectionsUrl, branchServices } from '../data/branches.ts';
import Photo from './Photo.astro';
import { hasPhoto } from '../lib/photos.ts';

interface Props {
  headingLevel?: 'h2' | 'h3';
  nearest?: boolean;
}
const { headingLevel = 'h3', nearest = false } = Astro.props;
const H = headingLevel;
---

<ol class="branch-ledger" role="list" data-branch-ledger>
  {
    liveBranches.map((b) => (
      <li
        class="branch-row"
        data-slug={b.slug}
        data-lat={nearest && b.approxGeo ? b.approxGeo.lat : undefined}
        data-lng={nearest && b.approxGeo ? b.approxGeo.lng : undefined}
      >
        <div class:list={['branch-row__in', { 'has-photo': b.photo && hasPhoto(b.photo) }]}>
          {b.photo && <Photo slug={b.photo} sizes="(min-width: 60rem) 22rem, 100vw" class="branch-photo" />}
          <div>
            <H>
              <a href={`/locations/${b.slug}/`}>{b.name}</a>
            </H>
            <p class="distance" data-distance aria-live="polite" />
            <address>{branchAddress(b)}</address>
            <p class="services">{branchServices(b).join(' · ')}</p>
          </div>
          <div class="acts">
            {b.phone && <a class="tel-label" href={`tel:${b.phone.e164}`}>{b.phone.display}</a>}
            <a href={branchDirectionsUrl(b)} rel="noopener" target="_blank">
              {t.common.directions}
              <span class="visually-hidden">
                {' '}
                {fmt(t.common.directionsTo, { name: b.name })} ({t.common.newTab})
              </span>
            </a>
            <a href={`/locations/${b.slug}/`}>
              {t.common.branchPage}
              <span class="visually-hidden"> {b.name}</span>
            </a>
          </div>
        </div>
      </li>
    ))
  }
</ol>
