---
/** Stroke icons, decorative only. Always pair with visible or hidden text. */
interface Props {
  name: 'phone' | 'pin' | 'search' | 'sun' | 'moon' | 'menu' | 'close' | 'up' | 'chat' | 'print';
  class?: string;
}
const { name, class: cls } = Astro.props;
const paths: Record<Props['name'], string> = {
  phone:
    'M5 4h3.5l1.5 4-2 1.5a11 11 0 0 0 6.5 6.5L16 14l4 1.5V19a1 1 0 0 1-1 1A15 15 0 0 1 4 5a1 1 0 0 1 1-1Z',
