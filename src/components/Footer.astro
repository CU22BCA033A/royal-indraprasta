---
import { t } from '../content/copy.ts';
import { site } from '../config/site.ts';
import { liveBranches, branchAddress, branchMapsUrl } from '../data/branches.ts';
import { legalItems, navItems } from '../lib/nav.ts';
import { contentDates, formatDate } from '../config/content-dates.ts';

const year = new Date().getFullYear();
const items = navItems();
---

<footer class="site-footer band--sign">
  <div class="wrap">
    <p class="footer-name" aria-hidden="true"><span>Royal</span>Indraprastha</p>
    <div class="grid footer-grid">
      {
        liveBranches.map((b) => (
          <section class="footer-branch" aria-labelledby={`footer-${b.slug}`}>
            <h2 id={`footer-${b.slug}`}>{b.area}</h2>
            <p class="name">
              <a href={`/locations/${b.slug}/`} class="footer-branch-link">
                {b.name}
              </a>
            </p>
            <address>
              <a href={branchMapsUrl(b)} rel="noopener" target="_blank">
                {branchAddress(b)}
                <span class="visually-hidden"> ({t.common.newTab})</span>
              </a>
            </address>
            {b.phone && (
              <p>
                <a class="tel-label" href={`tel:${b.phone.e164}`}>{b.phone.display}</a>
              </p>
            )}
          </section>
        ))
      }
      <nav class="footer-col" aria-labelledby="footer-site">
        <h2 id="footer-site">{t.common.footerNav}</h2>
        <ul role="list">
          {
            items.map((i) => (
              <li>
                <a href={i.path}>{t.common.nav[i.key]}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav class="footer-col" aria-labelledby="footer-legal">
        <h2 id="footer-legal">{t.footer.legal}</h2>
        <ul role="list">
          {
            legalItems.map((i) => (
              <li>
                <a href={i.path}>{t.footer[i.key]}</a>
              </li>
            ))
          }
        </ul>
        {
          (site.legalName || site.email || site.gstin || site.social.instagram || site.social.facebook) && (
            <dl>
              {site.legalName && (
                <div>
                  <dt>{t.footer.legalName}</dt>
                  <dd>{site.legalName}</dd>
                </div>
              )}
              {site.email && (
                <div>
                  <dt>{t.footer.email}</dt>
                  <dd>
                    <a href={`mailto:${site.email}`}>{site.email}</a>
                  </dd>
                </div>
              )}
              {site.gstin && (
                <div>
                  <dt>{t.footer.gstin}</dt>
                  <dd>{site.gstin}</dd>
                </div>
              )}
              {site.social.instagram && (
                <div>
                  <dt>{t.footer.instagram}</dt>
                  <dd>
                    <a href={site.social.instagram} rel="noopener" target="_blank">
                      Instagram<span class="visually-hidden"> ({t.common.newTab})</span>
                    </a>
                  </dd>
                </div>
              )}
            </dl>
          )
        }
      </nav>
    </div>
    <div class="footer-base">
      <p>{t.common.lastUpdated}: <time datetime={contentDates.site}>{formatDate(contentDates.site)}</time></p>
      <p data-copyright>&copy; {year} {site.legalName ?? site.tradingName}</p>
    </div>
  </div>
</footer>
