---
/** A branch's address set large, with copy and directions. */
import { t, fmt } from '../content/copy.ts';
import { type Branch, branchAddress, branchMapsUrl, branchDirectionsUrl } from '../data/branches.ts';
import CopyButton from './CopyButton.astro';
import Icon from './Icon.astro';

interface Props {
  branch: Branch;
}
const { branch } = Astro.props;
const addr = branchAddress(branch);
---

<div class="address-block">
  <p class="kicker">{t.locations.addressTitle}</p>
  <address class="address-big">
    <a href={branchMapsUrl(branch)} rel="noopener" target="_blank"
      >{addr}<span class="visually-hidden"> ({t.common.newTab})</span></a
    >
  </address>
  {
    branch.landmark && <p class="meta-line">{branch.landmark}</p>
  }
  {
    branch.plusCode && (
      <p class="meta-line">
        {t.locations.plusCode}: <span class="num">{branch.plusCode}</span>
      </p>
    )
  }
  <div class="btn-row">
    {
      branch.phone && (
        <a class="btn" href={`tel:${branch.phone.e164}`}>
          <Icon name="phone" />
          {fmt(t.common.callNumber, { phone: branch.phone.display })}
        </a>
      )
    }
    <a class:list={['btn', { 'btn--ghost': branch.phone }]} href={branchDirectionsUrl(branch)} rel="noopener" target="_blank">
      <Icon name="pin" />
      {t.common.directions}
      <span class="visually-hidden"> ({t.common.newTab})</span>
    </a>
  </div>
  <CopyButton
    value={`Royal Indraprastha, ${addr}`}
    label={t.common.copyAddress}
    copied={t.common.copied}
    failed={t.common.copyFailed}
  />
</div>
